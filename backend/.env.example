# Sahaara AI backend configuration
DATABASE_URL=sqlite:///./sahaara.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/sahaara
SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Optional: enables the Generative AI pipeline (Feature 1.9 primary path).
# When unset or unreachable the system falls back to the rule-based engine
# and enters "Human Assessment Mode" (Feature 1.14) as required.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Seed demo users on startup (username / password)
SEED_DEMO_USERS=true
